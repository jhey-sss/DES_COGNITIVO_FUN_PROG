@model DES_COGNITIVO_FUN_PROG.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Workspace";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-secondary fw-bold" style="color: #6c757d;">Resumen de tu Workspace</h2>
        <span class="text-muted"><i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dd MMMM yyyy")</span>
    </div>
    
    <!-- TARJETAS DE MÉTRICAS (COLORES PASTEL) -->
    <div class="row">
        <!-- Eventos Activos (Soft Blue) -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0 rounded-4" style="background-color: #e3f2fd;"> 
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase fw-bold mb-1" style="color: #5c8599; font-size: 0.8rem;">Eventos Activos</h6>
                            <h2 class="mb-0 fw-bold" style="color: #1565c0;">@Model.TotalEventosActivos</h2>
                        </div>
                        <div class="p-3 bg-white rounded-circle shadow-sm">
                            <i class="bi bi-calendar-event fs-4" style="color: #1976d2;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Clientes (Soft Purple/Lavender) -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0 rounded-4" style="background-color: #f3e5f5;"> 
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase fw-bold mb-1" style="color: #8c6b99; font-size: 0.8rem;">Clientes</h6>
                            <h2 class="mb-0 fw-bold" style="color: #6a1b9a;">@Model.TotalClientesActivos</h2>
                        </div>
                        <div class="p-3 bg-white rounded-circle shadow-sm">
                            <i class="bi bi-people fs-4" style="color: #7b1fa2;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Invitados Totales (Soft Blush Pink) -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0 rounded-4" style="background-color: #fce4ec;"> 
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase fw-bold mb-1" style="color: #a3687c; font-size: 0.8rem;">Invitados</h6>
                            <h2 class="mb-0 fw-bold" style="color: #c2185b;">@Model.TotalInvitados</h2>
                        </div>
                        <div class="p-3 bg-white rounded-circle shadow-sm">
                            <i class="bi bi-envelope-paper fs-4" style="color: #d81b60;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Eventos del Mes (Mint Green) -->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0 rounded-4" style="background-color: #e8f5e9;"> 
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-uppercase fw-bold mb-1" style="color: #639265; font-size: 0.8rem;">Eventos del Mes</h6>
                            <h2 class="mb-0 fw-bold" style="color: #2e7d32;">@Model.EventosEsteMes</h2>
                        </div>
                        <div class="p-3 bg-white rounded-circle shadow-sm">
                            <i class="bi bi-calendar-check fs-4" style="color: #388e3c;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BANNER DE ACCESO RÁPIDO -->
    <div class="card shadow-sm border-0 mt-2 rounded-4">
        <div class="card-body p-5 text-center" style="background-color: #fffafb; border: 2px dashed #f8bbd0; border-radius: 1rem;">
            <div class="mb-3">
                <i class="bi bi-stars" style="font-size: 3rem; color: #f48fb1;"></i>
            </div>
            <h3 class="fw-bold" style="color: #d81b60;">¡Bienvenido a tu Panel de Planificación!</h3>
            <p class="text-muted mt-3 mb-4 fs-5">Utiliza el menú lateral para navegar por tu espacio de trabajo y gestionar las bodas y eventos especiales de tus clientes.</p>
            
            <a asp-controller="Evento" asp-action="Create" class="btn text-white shadow rounded-pill px-4 py-2 me-2" style="background-color: #f48fb1; border: none;">
                <i class="bi bi-plus-circle me-1"></i> Planificar Nuevo Evento
            </a>
            <a asp-controller="Cliente" asp-action="Create" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                <i class="bi bi-person-plus me-1"></i> Registrar Cliente
            </a>
        </div>
    </div>
</div>