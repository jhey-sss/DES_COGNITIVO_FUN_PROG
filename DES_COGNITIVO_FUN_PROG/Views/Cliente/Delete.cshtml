@using DES_COGNITIVO_FUN_PROG.Models.ViewModels;
@model ClienteViewModel

<div class="container mt-4">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Eliminar Cliente</h3>
        </div>
        <div class="card-body">
            <h5 class="text-danger mb-4">
                <i class="bi bi-exclamation-triangle-fill"></i> 
                ¿Estás seguro de que deseas desactivar a este cliente?
            </h5>
            
            <div class="bg-light p-4 rounded mb-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.NumeroIdentidad)</dt>
                    <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.NumeroIdentidad)</dd>

                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Nombre)</dt>
                    <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.Nombre)</dd>
                 
                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Correo)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Correo)</dd>

                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Telefono)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Telefono)</dd>
                </dl>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="IdCliente"/>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Desactivar Cliente
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>