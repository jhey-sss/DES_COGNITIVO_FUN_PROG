@using DES_COGNITIVO_FUN_PROG.Models.ViewModels;
@model EventoViewModel

<div class="container mt-4">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Eliminar Evento</h3>
        </div>
        <div class="card-body">
            <h5 class="text-danger mb-4">
                <i class="bi bi-exclamation-triangle-fill"></i> 
                ¿Estás seguro de que deseas desactivar este evento?
            </h5>

            <div class="bg-light p-4 rounded mb-4">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.CodigoEvento)</dt>
                    <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.CodigoEvento)</dd>

                    <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.Nombre)</dt>
                    <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.Nombre)</dd>

                    <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.Fecha)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Fecha)</dd>

                    <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.Lugar)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Lugar)</dd>
                </dl>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="IdEvento" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Desactivar Evento
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>