@model List<DES_COGNITIVO_FUN_PROG.Models.Invitado>

<h1>Lista de Invitados</h1>
<div>
    <p>
        <a asp-action="Create" class="btn btn-success">Registrar Nuevo Invitado</a>
    </p>
</div>

<div>
    <form asp-controller="Invitado" asp-action="Index">
        <p>
            <input type="number" name="Buscar" value="@ViewData["BusquedaInvitado"]" class="form-text" />
            <input type="submit" value="buscar" class="btn btn-primary btn-dark" />
            <a asp-controller="Invitado" asp-action="Index" class="btn btn-secondary">Cancelar</a>

        </p>
    </form>

</div>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Evento</th>
            <th>Mesa</th>
            <th>Nombres</th>
            <th>DNI</th>
            <th>Confirmado</th>
            <th>Acompañantes</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdEventoNavigation?.Nombre</td>
                <td>@(item.IdMesaNavigation?.NumeroMesa.ToString() ?? "Sin mesa")</td>
                <td>@item.Nombres</td>
                <td>@item.Dni</td>
                <td>
                    @if (item.Confirmado == true) { <span class="badge bg-success">Sí</span> }
                    else { <span class="badge bg-secondary">No / Pendiente</span> }
                </td>
                <td>@item.NumAcompañantes</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdInvitado" class="btn btn-primary btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.IdInvitado" class="btn btn-danger btn-sm">Borrar</a>
                </td>
            </tr>
        }
    </tbody>
</table>