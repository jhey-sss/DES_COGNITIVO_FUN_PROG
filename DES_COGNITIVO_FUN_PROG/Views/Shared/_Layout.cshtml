<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GestionEventos</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DES_COGNITIVO_FUN_PROG.styles.css" asp-append-version="true" />
    

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- estilos qe mejoran la interface -->
    <style>
        body {
            background-color: #f8f9fa; /* Fondo general suave */
            overflow-x: hidden;
            margin-bottom: 0; /* site.css deja 60px de margen abajo, eso hacia la pagina mas alta que la pantalla y empujaba el boton de cerrar sesion fuera de la vista */
        }
        .wrapper {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }
        
        /* Configuración del Menú Lateral */
        .sidebar {
            width: 260px;
            background-color: #ffffff;
            border-right: 1px solid #fce4ec; /* Borde rosa pastel */
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 5px rgba(0,0,0,0.02);
            flex-shrink: 0;
            overflow-y: auto; /* si el menu no cabe en pantallas bajas, se desplaza dentro de la barra */
        }
        .sidebar-header {
            padding: 25px 20px;
            background-color: #f8bbd0; /* Rosa pastle elegante */
            color: #880e4f; /* Texto oscuro */
            text-align: center;
        }
        .sidebar ul li a {
            padding: 16px 20px;
            display: block;
            color: #6c757d;
            text-decoration: none;
            border-bottom: 1px solid #fdfbfb;
            font-weight: 500;
            transition: 0.2s ease-in-out;
        }
        .sidebar ul li a:hover, .sidebar ul li a.active {
            background-color: #fce4ec; /* Rosa muy suave al pasar el mouse */
            color: #d81b60;
            border-left: 4px solid #d81b60; /* Indicador activo */
        }
        .sidebar ul li a i {
            margin-right: 10px;
            font-size: 1.1rem;
        }
        .logout-container {
            margin-top: auto; /* Empuja el botón hacia abajo */
            padding: 20px;
        }

        /* Contenedor principal derecho */
        .content-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            overflow-y: auto;
            min-width: 0; /* evita que tableros y tablas anchas empujen el contenido fuera de la pantalla */
        }
        .main-content {
            flex-grow: 1;
            padding: 30px;
            min-width: 0;
        }

        /* Escritorio: la barra lateral se queda fija a la altura de la pantalla,
           asi el boton de Cerrar Sesion siempre se ve sin tener que bajar por toda la pagina */
        @@media (min-width: 992px) {
            .sidebar {
                position: sticky;
                top: 0;
                height: 100vh;
                align-self: flex-start;
            }
            .topbar-movil, .sidebar-fondo {
                display: none !important;
            }
        }

        /* Celular y tablet: el menu se oculta y se abre con el boton de la barra superior */
        @@media (max-width: 991.98px) {
            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                height: 100vh;
                z-index: 1045;
                transform: translateX(-100%);
                transition: transform 0.25s ease-in-out;
            }
            .sidebar.abierto {
                transform: translateX(0);
                box-shadow: 4px 0 20px rgba(0,0,0,0.15);
            }
            .sidebar-fondo {
                display: none;
                position: fixed;
                inset: 0;
                background-color: rgba(0,0,0,0.35);
                z-index: 1040;
            }
            .sidebar-fondo.visible {
                display: block;
            }
            .topbar-movil {
                display: flex;
                align-items: center;
                gap: 12px;
                position: sticky;
                top: 0;
                z-index: 1030;
                padding: 10px 16px;
                background-color: #f8bbd0;
                color: #880e4f;
            }
            .topbar-movil button {
                background: transparent;
                border: 0;
                color: #880e4f;
                font-size: 1.6rem;
                line-height: 1;
                padding: 0;
                min-width: 32px;
                min-height: 32px;
            }
            .main-content {
                padding: 16px;
            }
        }
        
        /* Ajuste de footer original */
        .custom-footer {
            background-color: transparent;
            padding: 15px 30px;
            border-top: 1px solid #dee2e6;
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <!-- BARRA LATERAL  -->
        <nav class="sidebar" id="menu-lateral" aria-label="Menú principal">
            <div class="sidebar-header">
                <h5 class="mb-0 fw-bold"><i class="bi bi-gem"></i> Event Planner</h5>
            </div>
            
            <ul class="list-unstyled mb-0">
                <li>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                        <i class="bi bi-house-door"></i> Dashboard
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Evento" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Evento" ? "active" : "")">
                        <i class="bi bi-calendar-heart"></i> Eventos
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Cliente" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Cliente" ? "active" : "")">
                        <i class="bi bi-people"></i> Clientes
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Invitado" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Invitado" || ViewContext.RouteData.Values["Controller"]?.ToString() == "EventoResumen" ? "active" : "")">
                        <i class="bi bi-envelope-paper"></i> Invitados
                    </a>
                </li>
                <li>
                    <a asp-area="" asp-controller="Mesa" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Mesa" ? "active" : "")">
                        <i class="bi bi-ui-radios-grid"></i> Mesas
                    </a>
                </li>
            </ul>

            <div class="logout-container">
                <a asp-controller="Administrador" asp-action="Logout" class="btn btn-outline-danger w-100 rounded-pill">
                    <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                </a>
            </div>
        </nav>

        <!-- fondo oscuro que cubre la pantalla cuando el menu esta abierto en celular -->
        <div class="sidebar-fondo" id="menu-fondo"></div>

        <!-- ÁREA DE CONTENIDO PRINCIPAL -->
        <div class="content-wrapper">

            <!-- barra superior que solo aparece en celular y tablet, con el boton para abrir el menu -->
            <div class="topbar-movil">
                <button type="button" id="menu-boton" aria-controls="menu-lateral" aria-expanded="false" aria-label="Abrir menú">
                    <i class="bi bi-list"></i>
                </button>
                <span class="fw-bold"><i class="bi bi-gem"></i> Event Planner</span>
            </div>

            <!-- Aquí se inyectan todas las vistas (Index, Create, Edit, etc) -->
            <main role="main" class="main-content">
                @RenderBody()
            </main>


            <footer class="custom-footer text-muted">
                © 2026 - DES_COGNITIVO_FUN_PROG - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // abre y cierra el menu lateral en celular y tablet
        (function () {
            const menu = document.getElementById('menu-lateral');
            const fondo = document.getElementById('menu-fondo');
            const boton = document.getElementById('menu-boton');
            if (!menu || !fondo || !boton) return;

            function alternar(abrir) {
                menu.classList.toggle('abierto', abrir);
                fondo.classList.toggle('visible', abrir);
                boton.setAttribute('aria-expanded', abrir ? 'true' : 'false');
            }

            boton.addEventListener('click', function () { alternar(!menu.classList.contains('abierto')); });
            fondo.addEventListener('click', function () { alternar(false); });
            menu.querySelectorAll('a').forEach(function (enlace) {
                enlace.addEventListener('click', function () { alternar(false); });
            });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') alternar(false); });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>