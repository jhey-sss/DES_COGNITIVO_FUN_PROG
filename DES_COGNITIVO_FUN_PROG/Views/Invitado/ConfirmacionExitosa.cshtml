@{
    ViewData["Title"] = "Confirmación Exitosa";
}

@{
    // Opcional:  poner Layout = null; si no quieres que se vea la barra de navegación del administrador
    Layout = null;

}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso a tu invitación</title>

    <!-- como el layout es null, aqui cargamos directamente los estilos que necesita esta vista -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            body {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(135deg, #fce4ec 0%, #f8bbd0 50%, #f3e5f5 100%); /* fondo rosa pastel como el panel */
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                padding: 1rem;
            }

            .acceso-card {
                width: 100%;
                max-width: 420px;
                border: none;
                border-radius: 1.5rem;
                background-color: #ffffff;
                box-shadow: 0 10px 30px rgba(216, 27, 96, 0.15);
            }

            .acceso-icono {
                width: 72px;
                height: 72px;
                margin: 0 auto 1rem;
                border-radius: 50%;
                background-color: #fce4ec;
                color: #d81b60;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 2rem;
            }

            .acceso-titulo {
                color: #d81b60;
                font-weight: 700;
            }

            .acceso-card .form-control {
                border-radius: 0.75rem;
                border: 1px solid #f8bbd0;
            }

                .acceso-card .form-control:focus {
                    border-color: #f48fb1;
                    box-shadow: 0 0 0 0.25rem rgba(244, 143, 177, 0.25);
                }

            .btn-acceso {
                background-color: #f48fb1;
                border: none;
                color: #ffffff;
                border-radius: 50rem;
                font-weight: 600;
                transition: 0.2s ease-in-out;
            }

                .btn-acceso:hover, .btn-acceso:focus {
                    background-color: #d81b60;
                    color: #ffffff;
                }
    </style>
</head>
<body>


<div class="container text-center mt-5 pt-5">
    <div class="mb-4">
        <i class="text-success" style="font-size: 5rem;">✅</i>
    </div>
    <h1 class="display-4">¡Gracias por tu respuesta!</h1>
    <p class="lead mt-3">Hemos guardado tu confirmación de asistencia correctamente.</p>
    <p class="text-muted">Ya puedes cerrar esta ventana.</p>
</div>

</body>
</html>