@using DES_COGNITIVO_FUN_PROG.Models.ViewModels;
@model MesaViewModel

<h1>Eliminar Mesa</h1>
<h3 class="text-danger">¿Estás seguro de que deseas eliminar esta mesa?</h3>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-3">Evento</dt>
        <dd class="col-sm-9">@ViewBag.NombreEvento</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NumeroMesa)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.NumeroMesa)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NombreMesa)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.NombreMesa)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Capacidad)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Capacidad)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdMesa" />
        <input type="submit" value="Desactivar Mesa" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>