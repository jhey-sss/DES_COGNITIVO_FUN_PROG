@using DES_COGNITIVO_FUN_PROG.Models.ViewModels
@model InvitadoConfirmacionViewModel

@{
    // Opcional:  poner Layout = null; si no quieres que se vea la barra de navegación del administrador
    Layout = null;

}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso a tu invitación</title>

    <!-- como el layout es null, aqui cargamos directamente los estilos que necesita esta vista -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            body {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(135deg, #fce4ec 0%, #f8bbd0 50%, #f3e5f5 100%); /* fondo rosa pastel como el panel */
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                padding: 1rem;
            }

            .acceso-card {
                width: 100%;
                max-width: 420px;
                border: none;
                border-radius: 1.5rem;
                background-color: #ffffff;
                box-shadow: 0 10px 30px rgba(216, 27, 96, 0.15);
            }

            .acceso-icono {
                width: 72px;
                height: 72px;
                margin: 0 auto 1rem;
                border-radius: 50%;
                background-color: #fce4ec;
                color: #d81b60;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 2rem;
            }

            .acceso-titulo {
                color: #d81b60;
                font-weight: 700;
            }

            .acceso-card .form-control {
                border-radius: 0.75rem;
                border: 1px solid #f8bbd0;
            }

                .acceso-card .form-control:focus {
                    border-color: #f48fb1;
                    box-shadow: 0 0 0 0.25rem rgba(244, 143, 177, 0.25);
                }

            .btn-acceso {
                background-color: #f48fb1;
                border: none;
                color: #ffffff;
                border-radius: 50rem;
                font-weight: 600;
                transition: 0.2s ease-in-out;
            }

                .btn-acceso:hover, .btn-acceso:focus {
                    background-color: #d81b60;
                    color: #ffffff;
                }
    </style>
</head>


<body>

<div class="container mt-5" style="max-width: 700px;">
    <div class="text-center mb-5">
        <h2>Hola, <span class="text-primary">@Model.Nombres</span></h2>
        <p class="lead">Por favor confirma tu asistencia a nuestro evento.</p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
            <form asp-action="ConfirmarAsistencia" method="post">
                <input type="hidden" asp-for="IdInvitado" />

                <div class="form-group mb-4 text-center">
                    <label class="fw-bold fs-5 mb-3">¿Asistirás al evento?</label><br />
                    <div class="btn-group" role="group">
                        <input type="radio" class="btn-check" name="Confirmado" id="btnradio1" value="true" @(Model.Confirmado ? "checked" : "")>
                        <label class="btn btn-outline-success px-4" for="btnradio1">Sí, asistiré</label>

                        <input type="radio" class="btn-check" name="Confirmado" id="btnradio2" value="false" @(!Model.Confirmado ? "checked" : "")>
                        <label class="btn btn-outline-danger px-4" for="btnradio2">No podré asistir</label>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="NumAcompañantes" class="form-label fw-bold"></label>
                    <input asp-for="NumAcompañantes" class="form-control" type="number" min="0" />
                    <span asp-validation-for="NumAcompañantes" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="RestriccionesAlimentarias" class="form-label fw-bold"></label>
                    <input asp-for="RestriccionesAlimentarias" class="form-control" placeholder="Ej: Vegano, Alergia a mariscos..." />
                    <span asp-validation-for="RestriccionesAlimentarias" class="text-danger"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">Enviar Confirmación</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Sección de compañeros de mesa -->
    <div class="card shadow-sm bg-light">
        <div class="card-body p-4 text-center">
            <h5 class="card-title fw-bold text-secondary"Compartirás mesa con:</h5>
            @if (Model.CompañerosDeMesa.Any())
            {
                <ul class="list-unstyled mt-3 mb-0 fs-5">
                    @foreach (var companero in Model.CompañerosDeMesa)
                    {
                        <li class="mb-2"><strong>@companero</strong></li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted mt-3 mb-0">Aún no se te han asignado compañeros de mesa.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
</body>

</html>