@using DES_COGNITIVO_FUN_PROG.Models.ViewModels;
@model MesaViewModel

<h1>Crear Mesa</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="IdEvento" class="control-label"></label>
                <select asp-for="IdEvento" class="form-control" asp-items="ViewBag.IdEvento">
                    <option value="">-- Seleccione un Evento --</option>
                </select>
                <span asp-validation-for="IdEvento" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NumeroMesa" class="control-label"></label>
                <input asp-for="NumeroMesa" class="form-control" type="number" />
                <span asp-validation-for="NumeroMesa" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NombreMesa" class="control-label"></label>
                <input asp-for="NombreMesa" class="form-control" placeholder="Ej: Familia VIP" />
                <span asp-validation-for="NombreMesa" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Capacidad" class="control-label"></label>
                <input asp-for="Capacidad" class="form-control" type="number" />
                <span asp-validation-for="Capacidad" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Crear" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}